# Copie este archivo como ".env" y ajuste los valores. El archivo ".env" NO se versiona.
# Genere una clave propia y distinta en cada entorno:
#   python -c "import secrets; print(secrets.token_urlsafe(60))"
# Con DJANGO_DEBUG=False la clave es obligatoria; con True y vacía se usa una clave solo de desarrollo.
DJANGO_SECRET_KEY=
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,192.168.0.17

DB_NAME=paceno
DB_USER=paceno
DB_PASSWORD=cambie-esta-contrasena
DB_HOST=localhost
DB_PORT=5432

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://192.168.0.17:5173
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://192.168.0.17:8000

# Semana 3: máximo de reportes por IP (formato N/hour o N/minute) y proxies delante del servidor.
# NUM_PROXIES = cantidad de proxies inversos entre el visitante y Django (0 = ninguno). Debe ser exacto:
# la IP del visitante se toma de X-Forwarded-For según este número.
REPORTES_LIMITE=5/hour
NUM_PROXIES=0
# Espacio social: límites de frecuencia (registro e ingreso por IP; escrituras y solicitudes de amistad por cuenta)
SOCIAL_REGISTRO_LIMITE=5/hour
SOCIAL_ACCESO_LIMITE=20/hour
SOCIAL_ESCRITURA_LIMITE=120/hour
SOCIAL_AMISTAD_LIMITE=20/day

# Solo en producción detrás de un proxy que termina HTTPS y SIEMPRE reescribe X-Forwarded-Proto.
# Evita el bucle de redirección de SECURE_SSL_REDIRECT. Déjelo en False si no hay proxy.
USAR_X_FORWARDED_PROTO=False


# --- Producción (Render): ver render.yaml y Dockerfile ---
# DATABASE_URL=postgresql://usuario:clave@host:5432/base   (si existe, reemplaza a DB_*)
# MEDIA_ROOT=/data/media                                    (disco persistente para fotos y banners)
# SERVIR_MEDIA=True                                         (Django sirve /media/ cuando DEBUG=False)
# RENDER_EXTERNAL_HOSTNAME lo define Render solo; se agrega a ALLOWED_HOSTS y CSRF_TRUSTED_ORIGINS.
# DJANGO_SUPERUSER_USERNAME / DJANGO_SUPERUSER_PASSWORD / DJANGO_SUPERUSER_EMAIL   (crea el administrador al arrancar)
