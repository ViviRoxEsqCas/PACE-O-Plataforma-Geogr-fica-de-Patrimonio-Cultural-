+    from urllib.parse import parse_qs, unquote, urlparse
 
     _bd = urlparse(_URL_BD)
     DATABASES["default"].update(
         NAME=unquote(_bd.path.lstrip("/")), USER=unquote(_bd.username or ""), PASSWORD=unquote(_bd.password or ""),
