+}
+const foto = (p, nombre, opciones = {}) => p.screenshot({ path: `${SALIDA}/${nombre}.png`, ...opciones });
+const mensajes = (p) => p.locator(".messagelist li").allInnerTexts();
+async function elegirEnSelect2(p, selectId, texto) {
